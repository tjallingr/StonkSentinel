# Copy to /etc/finoverview/env on the Pi, chmod 600, owner root.
# These override the values in settings.toml.

ENABLEBANKING_APP_ID=
ENABLEBANKING_KEY_PATH=/opt/finoverview/secrets/enablebanking.pem

SAXO_APP_KEY=
SAXO_APP_SECRET=

# Backups
# Cloud (B2) example:
RESTIC_REPOSITORY=b2:your-bucket:finoverview
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Local cold-storage drive instead: point RESTIC_REPOSITORY at a path under its
# mount, and set BACKUP_MOUNT_PATH to that mount point so backup.sh skips
# gracefully (not a failure) on nights the drive isn't plugged in.
# RESTIC_REPOSITORY=/mnt/backup-hdd/restic-repo
# BACKUP_MOUNT_PATH=/mnt/backup-hdd
RESTIC_PASSWORD_FILE=/etc/finoverview/restic.pass

# Collector failure alert. Leave blank to only log to the journal.
NTFY_URL=https://ntfy.sh/your-private-topic
