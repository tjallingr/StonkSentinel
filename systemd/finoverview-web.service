[Unit]
Description=finance-overview dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=finoverview
Group=finoverview
WorkingDirectory=/opt/finoverview
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/finoverview/src
EnvironmentFile=-/etc/finoverview/env
# Bind to loopback only. Tailscale serve handles TLS and exposure; nothing here
# should ever listen on 0.0.0.0.
ExecStart=/opt/finoverview/.venv/bin/uvicorn finoverview.web.app:app \
    --host 127.0.0.1 --port 8080 --workers 1 --no-access-log
Restart=always
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# ProtectSystem=strict makes everything read-only except what is listed here.
# config/ has to be writable because the settings pages edit assets.toml — the
# projection horizon, asset values, Saxo categories. Without it every save in
# the UI fails with a permission error that looks like a file-ownership problem
# and isn't: the file is fine, the mount namespace is read-only.
ReadWritePaths=/opt/finoverview/data /opt/finoverview/config
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
